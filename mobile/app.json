{
  "expo": {
    "name": "IlmConnect",
    "slug": "ilmconnect",
    "scheme": "zoq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9F5",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow IlmConnect to find verified scholars near you.",
          "locationAlwaysAndWhenInUsePermission": "Allow IlmConnect to find nearby scholars."
        }
      ]
    ]
  }
}
